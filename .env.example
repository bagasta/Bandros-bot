APP_ENV=development
DATABASE_PATH=./data/agent-workspace.db
# DATABASE_URL=postgresql://agent:agent@postgres:5432/agent_workspace
DATABASE_URL=postgresql://agent:change-me@localhost:5432/agent_workspace
DBOS_SYSTEM_DATABASE_URL=postgresql://agent:change-me@localhost:5432/agent_workspace
DEV_USER_EMAIL=local@example.test
OPENROUTER_API_KEY=
OPENAI_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/chatgpt/callback
OPENAI_SCOPES=openid profile email offline_access resource.invoke chatgpt.tokens.use.direct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/free
WORKSPACE_ROOT=./data/workspaces
MAX_MODEL_CALLS_PER_RUN=8
API_AUTH_TOKEN=
